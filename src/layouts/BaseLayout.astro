---
import "../styles.css";

interface Props {
  title?: string;
}

const { title = "CoolHinge" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="shortcut icon" href="favicon.ico" />
    <title>{title}</title>

    <script
      defer
      src="https://api.pirsch.io/pa.js"
      id="pianjs"
      data-code="luo6jgiewATj6EkRmwje3C1CMB8Dk8kZ"></script>
  </head>
  <body class="min-h-screen text-white">
    <slot />
  </body>
</html>
